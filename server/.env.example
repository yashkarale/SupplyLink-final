PORT=5000
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000
# Local development only. Replace with your MongoDB Atlas or production connection string in production.
MONGODB_URI=mongodb://localhost:27017/supplylink
# Dedicated isolated database used only by the opt-in staging integration suite.
STAGING_MONGODB_URI=mongodb://supplylink_staging_runner:staging-runner-local-only@localhost:27017/supplylink_staging?authSource=supplylink_staging&replicaSet=rs0
RUN_STAGING_INTEGRATION=0
STAGING_DATABASE_CONFIRM=supplylink_staging
STAGING_HOST_CONFIRM=localhost:27017
MONGODB_ORDER_WRITE_LIMIT_MB=350
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
NODE_ENV=development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Supply Link <orders@example.com>
APP_BASE_URL=https://your-store-domain.example
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
