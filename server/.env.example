PORT=5000
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

# MongoDB and app runtime
MONGODB_URI=mongodb://localhost:27017/supplylink
# Replica-capable MongoDB is required for transaction-safe inventory and order writes.
STAGING_MONGODB_URI=mongodb://supplylink_staging_runner:staging-runner-local-only@localhost:27017/supplylink_staging?authSource=supplylink_staging&replicaSet=rs0
RUN_STAGING_INTEGRATION=0
STAGING_DATABASE_CONFIRM=supplylink_staging
STAGING_HOST_CONFIRM=localhost:27017
MONGODB_ORDER_WRITE_LIMIT_MB=350

# Security and auth
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1d
NODE_ENV=development

# Billing and email
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Supply Link <orders@example.com>
APP_BASE_URL=http://localhost:5173

# Media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production note:
# - Set CLIENT_URL to the HTTPS frontend origin(s) in production, not localhost.
# - Set APP_BASE_URL to the live storefront origin used for verification links.
# - Keep all secrets in the deployment secret manager, never in source control.
