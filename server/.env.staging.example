# Platform-neutral staging runtime template. This is not a hosting manifest.
# Set production runtime behavior in staging; use only staging services and test credentials.
# Store real secrets in the selected host's secret manager, never in this file.
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<staging-user>:<staging-password>@<staging-cluster>/supplylink_staging?authSource=admin&retryWrites=true&w=majority&readPreference=primary
# Keep integration-test URI/confirmation variables in a separate short-lived test job, not the app runtime.
CLIENT_URL=https://staging.supplylink.example
API_PUBLIC_URL=https://api-staging.supplylink.example
APP_BASE_URL=https://staging.supplylink.example
JWT_SECRET=<unique-random-staging-secret-at-least-32-characters>
JWT_EXPIRES_IN=1d
MONGODB_ORDER_WRITE_LIMIT_MB=256

# Terminate HTTPS at the selected platform/reverse proxy. Route its health checks to
# /api/health (process liveness) and /api/ready (MongoDB readiness). Forward stdout/stderr
# to a restricted, retained log service; this app does not configure an external sink.

# Configure test-mode Razorpay credentials from a staging-only Razorpay account.
RAZORPAY_KEY_ID=rzp_test_<staging-key-id>
RAZORPAY_KEY_SECRET=<staging-test-key-secret>

# Use a verified staging sender/domain and a staging webhook signing secret.
RESEND_API_KEY=<staging-email-provider-key>
RESEND_WEBHOOK_SECRET=<staging-email-webhook-secret>
EMAIL_FROM=Supply Link Staging <staging@your-verified-domain.example>

# Use a separate staging Cloudinary account/cloud.
CLOUDINARY_CLOUD_NAME=<staging-cloud-name>
CLOUDINARY_API_KEY=<staging-cloudinary-key>
CLOUDINARY_API_SECRET=<staging-cloudinary-secret>
